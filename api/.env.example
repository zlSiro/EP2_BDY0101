# Copiar este archivo a ".env" y completar. NUNCA subir ".env" al repositorio.

# String de conexion de Atlas (Connect > Drivers). Usuario con rol readWrite sobre la base.
# Si la contrasena tiene caracteres especiales, codificarla (URL-encode).
# readConcernLevel=majority y w=majority fijan el nivel de consistencia.
MONGODB_URI=mongodb+srv://<USUARIO>:<PASSWORD>@<HOST_DEL_CLUSTER>/?retryWrites=true&w=majority&readConcernLevel=majority

# Base de datos del proyecto
MONGODB_DB=EP2_BDY0101

# Puerto HTTP de la API
PORT=3000

# Opcional: DNS publicos para resolver mongodb+srv si el router falla
# (error "querySrv ECONNREFUSED"). Separar con coma.
DNS_SERVERS=8.8.8.8,1.1.1.1
