        {
          "name": "POST /usuarios",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('correo_prueba', 'postman+' + Date.now() + '@contentflow.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('devuelve _id', () => pm.expect(j._id).to.be.a('string'));",
                  "pm.collectionVariables.set('usuario_id', j._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
