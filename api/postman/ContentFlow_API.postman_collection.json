            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Postman\",\n  \"correo\": \"{{correo_prueba}}\",\n  \"pais\": \"Chile\",\n  \"genero\": \"Otro\",\n  \"dispositivo\": \"Móvil\"\n}",
