              "raw": "{{baseUrl}}/usuarios/{{usuario_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{usuario_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pais\": \"Argentina\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET /usuarios (filtro + paginacion)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('trae data', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios?genero=Femenino&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ],
              "query": [
                {
                  "key": "genero",
                  "value": "Femenino"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        }
